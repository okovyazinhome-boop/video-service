[
  {
    "url": "/render",
    "method": "POST",
    "body": {
      "images": "{{parameters.images}}",
      "voiceMp3": "{{parameters.voiceMp3}}",
      "musicMp3": "{{if(parameters.musicMp3, parameters.musicMp3, omit)}}",
      "musicVolume": "{{if(parameters.musicVolume, parameters.musicVolume, 0.15)}}",
      "subtitlesText": "{{if(parameters.subtitlesText, parameters.subtitlesText, omit)}}",
      "wordTimings": "{{if(parameters.wordTimings, parameters.wordTimings, omit)}}",
      "videoPreset": "{{if(get(parameters.videoSettings, 'videoPreset'), get(parameters.videoSettings, 'videoPreset'), 'reels_1080_30')}}",
      "orientation": "{{if(get(parameters.videoSettings, 'orientation'), get(parameters.videoSettings, 'orientation'), '9:16')}}",
      "quality": "{{if(get(parameters.videoSettings, 'quality'), get(parameters.videoSettings, 'quality'), 'full-hd')}}",
      "fps": "{{if(get(parameters.videoSettings, 'fps'), get(parameters.videoSettings, 'fps'), '30')}}",
      "transitionType": "{{if(get(parameters.videoSettings, 'transitionType'), get(parameters.videoSettings, 'transitionType'), 'fade')}}",
      "bitratePreset": "{{if(get(parameters.videoSettings, 'bitratePreset'), get(parameters.videoSettings, 'bitratePreset'), 'standard')}}",
      "resolution": "{{if(get(parameters.advancedSettings, 'resolution'), get(parameters.advancedSettings, 'resolution'), omit)}}",
      "logoUrl": "{{if(get(parameters.brandSettings, 'logoUrl'), get(parameters.brandSettings, 'logoUrl'), omit)}}",
      "logoPosition": "{{if(get(parameters.brandSettings, 'logoPosition'), get(parameters.brandSettings, 'logoPosition'), 'top-right')}}",
      "webhookUrl": "{{if(get(parameters.advancedSettings, 'webhookUrl'), get(parameters.advancedSettings, 'webhookUrl'), omit)}}",
      "cleanMetadata": "{{if(get(parameters.advancedSettings, 'cleanMetadata') !== undefined, get(parameters.advancedSettings, 'cleanMetadata'), true)}}",
      "subtitleStyle": {
        "mode": "{{if(get(parameters.subtitleSettings, 'mode'), get(parameters.subtitleSettings, 'mode'), 'word-highlight')}}",
        "position": "{{if(get(parameters.subtitleSettings, 'position'), get(parameters.subtitleSettings, 'position'), 'bottom')}}",
        "animation": "{{if(get(parameters.subtitleSettings, 'animation'), get(parameters.subtitleSettings, 'animation'), 'fade')}}",
        "fontName": "{{if(get(parameters.subtitleSettings, 'fontName'), get(parameters.subtitleSettings, 'fontName'), 'Inter')}}",
        "fontSize": "{{if(get(parameters.subtitleSettings, 'fontSize'), get(parameters.subtitleSettings, 'fontSize'), omit)}}",
        "primaryColor": "{{ifempty(get(parameters.subtitleSettings, 'primaryColor'), '#FFFFFF')}}",
        "outlineColor": "{{ifempty(get(parameters.subtitleSettings, 'outlineColor'), '#000000')}}",
        "activeWordTextColor": "{{if(get(parameters.subtitleSettings, 'activeWordTextColor'), get(parameters.subtitleSettings, 'activeWordTextColor'), omit)}}",
        "activeWordBackColor": "{{if(get(parameters.subtitleSettings, 'activeWordBackColor'), get(parameters.subtitleSettings, 'activeWordBackColor'), omit)}}",
        "keywordColor": "{{ifempty(get(parameters.subtitleSettings, 'keywordColor'), '#FFD700')}}",
        "bold": "{{if(get(parameters.subtitleSettings, 'bold') !== undefined, get(parameters.subtitleSettings, 'bold'), true)}}"
      }
    },
    "response": {
      "valid": "{{body.ok === true}}",
      "error": {
        "type": "RuntimeError",
        "message": "[{{statusCode}}] {{body.error}}"
      },
      "temp": {
        "jobId": "{{body.jobId}}"
      }
    }
  },
  {
    "url": "/status/{{temp.jobId}}",
    "method": "GET",
    "response": {
      "valid": "{{body.ok === true}}",
      "error": {
        "type": "RuntimeError",
        "message": "[{{statusCode}}] {{body.error}}"
      },
      "temp": {
        "jobId": "{{temp.jobId}}",
        "status": "{{body.status}}",
        "queuePosition": "{{body.queuePosition}}"
      }
    },
    "repeat": {
      "condition": "{{temp.status !== 'done' && temp.status !== 'fail'}}",
      "delay": 10000,
      "limit": 720
    }
  },
  {
    "url": "/result/{{temp.jobId}}",
    "method": "GET",
    "response": {
      "valid": "{{body.ok === true && body.status === 'done'}}",
      "error": {
        "type": "RuntimeError",
        "message": "{{if(body.status === 'fail', 'Render failed: ' + (body.error || 'Unknown error'), '[' + statusCode + '] ' + (body.error || 'Unknown error'))}}"
      },
      "output": {
        "jobId": "{{body.jobId}}",
        "status": "{{body.status}}",
        "videoUrl": "{{body.videoUrl}}",
        "thumbnailUrl": "{{body.thumbnailUrl}}",
        "error": "{{body.error}}"
      }
    }
  }
]
