[
  {
    "url": "/render",
    "method": "POST",
    "body": {
      "images": "{{parameters.images}}",
      "voiceMp3": "{{get(parameters.audioSettings, 'voiceMp3')}}",
      "musicMp3": "{{if(get(parameters.audioSettings, 'musicMp3'), get(parameters.audioSettings, 'musicMp3'), omit)}}",
      "musicVolume": "{{if(get(parameters.audioSettings, 'musicVolume'), get(parameters.audioSettings, 'musicVolume'), 0.15)}}",
      "subtitlesText": "{{if(get(parameters.subtitleSettings, 'subtitlesText'), get(parameters.subtitleSettings, 'subtitlesText'), omit)}}",
      "wordTimings": "{{if(get(parameters.subtitleSettings, 'wordTimings'), get(parameters.subtitleSettings, 'wordTimings'), omit)}}",
      "videoPreset": "{{if(get(parameters.videoSettings, 'videoPreset'), get(parameters.videoSettings, 'videoPreset'), 'reels_1080_30')}}",
      "orientation": "{{if(get(parameters.videoSettings, 'orientation'), get(parameters.videoSettings, 'orientation'), '9:16')}}",
      "quality": "{{if(get(parameters.videoSettings, 'quality'), get(parameters.videoSettings, 'quality'), 'full-hd')}}",
      "fps": "{{if(get(parameters.videoSettings, 'fps'), get(parameters.videoSettings, 'fps'), '30')}}",
      "transitionType": "{{if(get(parameters.videoSettings, 'transitionType'), get(parameters.videoSettings, 'transitionType'), 'fade')}}",
      "bitratePreset": "{{if(get(parameters.videoSettings, 'bitratePreset'), get(parameters.videoSettings, 'bitratePreset'), 'standard')}}",
      "resolution": "{{if(get(parameters.advancedMode, 'resolution'), get(parameters.advancedMode, 'resolution'), omit)}}",
      "logoUrl": "{{if(get(parameters.brandMode, 'logoUrl'), get(parameters.brandMode, 'logoUrl'), omit)}}",
      "logoPosition": "{{if(get(parameters.brandMode, 'logoPosition'), get(parameters.brandMode, 'logoPosition'), 'top-right')}}",
      "webhookUrl": "{{if(get(parameters.advancedMode, 'webhookUrl'), get(parameters.advancedMode, 'webhookUrl'), omit)}}",
      "cleanMetadata": "{{if(get(parameters.advancedMode, 'cleanMetadata') !== undefined, get(parameters.advancedMode, 'cleanMetadata'), true)}}",
      "subtitleStyle": {
        "preset": "{{if(get(parameters.subtitleSettings, 'preset'), get(parameters.subtitleSettings, 'preset'), 'custom')}}",
        "position": "{{if(get(parameters.subtitleSettings, 'position'), get(parameters.subtitleSettings, 'position'), 'bottom')}}",
        "mode": "{{if(ifempty(get(parameters.subtitleSettings, 'preset'), 'custom') == 'custom', if(get(parameters.subtitleSettings, 'mode'), get(parameters.subtitleSettings, 'mode'), 'word-highlight'), omit)}}",
        "animation": "{{if(ifempty(get(parameters.subtitleSettings, 'preset'), 'custom') == 'custom', if(get(parameters.subtitleSettings, 'animation'), get(parameters.subtitleSettings, 'animation'), 'fade'), omit)}}",
        "fontName": "{{if(ifempty(get(parameters.subtitleSettings, 'preset'), 'custom') == 'custom', if(get(parameters.subtitleSettings, 'fontName'), get(parameters.subtitleSettings, 'fontName'), 'Inter'), omit)}}",
        "fontSize": "{{if(ifempty(get(parameters.subtitleSettings, 'preset'), 'custom') == 'custom', if(get(parameters.subtitleSettings, 'fontSize'), get(parameters.subtitleSettings, 'fontSize'), omit), omit)}}",
        "primaryColor": "{{if(ifempty(get(parameters.subtitleSettings, 'preset'), 'custom') == 'custom', ifempty(get(parameters.subtitleSettings, 'primaryColor'), '#FFFFFF'), omit)}}",
        "outlineColor": "{{if(ifempty(get(parameters.subtitleSettings, 'preset'), 'custom') == 'custom', ifempty(get(parameters.subtitleSettings, 'outlineColor'), '#000000'), omit)}}",
        "outline": "{{if(ifempty(get(parameters.subtitleSettings, 'preset'), 'custom') == 'custom', if(get(parameters.subtitleSettings, 'outline') !== undefined, get(parameters.subtitleSettings, 'outline'), 2), omit)}}",
        "activeWordTextColor": "{{if(ifempty(get(parameters.subtitleSettings, 'preset'), 'custom') == 'custom', if(get(parameters.subtitleSettings, 'activeWordTextColor'), get(parameters.subtitleSettings, 'activeWordTextColor'), omit), omit)}}",
        "activeWordBackColor": "{{if(ifempty(get(parameters.subtitleSettings, 'preset'), 'custom') == 'custom', if(get(parameters.subtitleSettings, 'activeWordBackColor'), get(parameters.subtitleSettings, 'activeWordBackColor'), omit), omit)}}",
        "keywordColor": "{{if(ifempty(get(parameters.subtitleSettings, 'preset'), 'custom') == 'custom', ifempty(get(parameters.subtitleSettings, 'keywordColor'), '#FFD700'), omit)}}"
      }
    },
    "response": {
      "valid": "{{body.ok === true}}",
      "error": {
        "type": "RuntimeError",
        "message": "[{{statusCode}}] {{body.error}}"
      },
      "temp": {
        "jobId": "{{body.jobId}}"
      }
    }
  },
  {
    "url": "/status/{{temp.jobId}}",
    "method": "GET",
    "response": {
      "valid": "{{body.ok === true}}",
      "error": {
        "type": "RuntimeError",
        "message": "[{{statusCode}}] {{body.error}}"
      },
      "temp": {
        "jobId": "{{temp.jobId}}",
        "status": "{{body.status}}",
        "queuePosition": "{{body.queuePosition}}"
      }
    },
    "repeat": {
      "condition": "{{temp.status !== 'done' && temp.status !== 'fail'}}",
      "delay": 10000,
      "limit": 720
    }
  },
  {
    "url": "/result/{{temp.jobId}}",
    "method": "GET",
    "response": {
      "valid": "{{body.ok === true && body.status === 'done'}}",
      "error": {
        "type": "RuntimeError",
        "message": "{{if(body.status === 'fail', 'Render failed: ' + (body.error || 'Unknown error'), '[' + statusCode + '] ' + (body.error || 'Unknown error'))}}"
      },
      "output": {
        "jobId": "{{body.jobId}}",
        "status": "{{body.status}}",
        "videoUrl": "{{body.videoUrl}}",
        "thumbnailUrl": "{{body.thumbnailUrl}}",
        "error": "{{body.error}}"
      }
    }
  }
]
